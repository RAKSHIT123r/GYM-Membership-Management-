{
  "name": "gym-membership-management-system",
  "version": "1.0.0",
  "description": "Full-stack Gym Membership Management System with Admin, Trainer, and Member portals",
  "main": "backend/server.js",
  "scripts": {
    "setup": "npm install && npm install --prefix backend",
    "seed": "cd backend && node utils/seedData.js",
    "server": "cd backend && npm run dev",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "cd backend && node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.436.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1"
  },
  "keywords": ["gym", "membership", "react", "express", "mongodb", "fullstack"],
  "author": "",
  "license": "ISC"
}
